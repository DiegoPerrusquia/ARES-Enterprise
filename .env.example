# ARES Enterprise — example environment configuration.
# Copy to `.env` and fill in real values. NEVER commit a real `.env`.
# All variables are prefixed with ARES_ and consumed by ares.core.config.Settings.

# --- General ---
ARES_ENVIRONMENT=development          # development | staging | production
ARES_LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
ARES_LOG_JSON=false                   # true -> structured JSON logs

# --- Persistence (Phase 3+) ---
# PostgreSQL + pgvector is the single source of truth for dev and prod.
ARES_DATABASE_URL=postgresql+psycopg://ares:ares@localhost:5432/ares

# --- LLM providers (Phase 4+) ---
# Keys are read from the environment only; they must never be hardcoded.
ARES_LLM_PROVIDER=anthropic           # anthropic | openai | ollama
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# ARES_OLLAMA_BASE_URL=http://localhost:11434

# --- Governance defaults ---
ARES_DEFAULT_PROFILE=PASSIVE          # PASSIVE | ASSESSMENT | LAB | ADVERSARY_EMULATION | FORENSICS | ENGINEERING
ARES_REQUIRE_APPROVAL=true            # fail-closed: sensitive ops require explicit approval
